{
  "name": "soundshark-explorer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fake-map": "node scripts/fake-map.mjs",
    "predev": "node scripts/write-index.mjs && node scripts/fake-map.mjs --if-missing",
    "dev": "vite",
    "build": "node scripts/write-index.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "node scripts/fake-map.mjs --artists 800 && npm run build && playwright test"
  },
  "dependencies": {
    "@cosmograph/react": "2.5.1",
    "@duckdb/duckdb-wasm": "1.32.0",
    "3d-force-graph": "1.80.1",
    "apache-arrow": "17.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}

# Copy to .env (gitignored) and list the sources to run.
# Format: comma-separated "module.path:ClassName". Defaults to the demo source.
WAVELENGTH_SOURCES=wavelength.sources.demo:DemoSource

# With a private sources package installed, e.g.:
# WAVELENGTH_SOURCES=my_private_sources.some_site:SomeSite,my_private_sources.other_site:OtherSite
